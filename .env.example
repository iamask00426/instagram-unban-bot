# Required: replace locally. No embedded defaults or direct Instagram fallback.
BOT_TOKEN=your_bot_token_here
# HTTP(S) only. URL credentials must be percent-encoded; SOCKS is unsupported.
# Also accepts host:port or host:port:user:password; separate entries with commas.
PROXIES=http://your_proxy_user:your_proxy_password@proxy.example.com:8080

# HTML is default. A placeholder cookie never enables API requests.
IG_CHECK_MODE=html
IG_SESSIONID=

# Normal per-account delay AFTER completion (seconds).
CHECK_INTERVAL_SECONDS=2
CHECK_CONCURRENCY=10
# Each of encoded/application-decompressed consumption is capped (not billable bytes).
PROFILE_BODY_LIMIT_BYTES=131072
REQUEST_TIMEOUT_SECONDS=10
BACKOFF_BASE_SECONDS=10
BACKOFF_MAX_SECONDS=300
# /banmonitor confirms unavailable, never proves banned/disabled.
UNAVAILABLE_CONFIRMATIONS=2
CONFIRMATION_INTERVAL_SECONDS=5

# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_UNBAN_CHANNEL_ID=
DISCORD_BAN_CHANNEL_ID=
