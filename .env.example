BOT_TOKEN=your_telegram_bot_token_here
# Leave empty to use bounded HTML checks; set a valid cookie to use JSON only.
IG_SESSIONID=
# Required. Comma-separated HTTP proxy URLs; never commit real credentials.
PROXIES=http://user:password@host:port

# First check is immediate; subsequent checks are spaced per account.
CHECK_INTERVAL_SECONDS=60
MAX_BACKOFF_SECONDS=3600
MAX_CONCURRENT_CHECKS=3
# Maximum decompressed response bytes consumed per check (128 KiB).
MAX_RESPONSE_BYTES=131072
